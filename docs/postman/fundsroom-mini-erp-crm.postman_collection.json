{
  "info": {
    "_postman_id": "b5cb2e25-df66-4b34-a8f5-45b77b47f901",
    "name": "FundsRoom Mini ERP + CRM",
    "description": "Backend API collection for authentication, CRM, inventory, and challan flows.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@fundsroom.local\",\n  \"password\": \"Admin@12345\"\n}"
            },
            "description": "Returns a JWT token. Negative case: invalid credentials return 401."
          }
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "me"
              ]
            },
            "description": "Bearer-token check for the current authenticated user. Missing or invalid token returns 401."
          }
        }
      ]
    },
    {
      "name": "Customers",
      "item": [
        {
          "name": "Create Customer",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/customers",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "customers"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerName\": \"Acme Wholesale\",\n  \"mobile\": \"9999900001\",\n  \"customerType\": \"WHOLESALE\",\n  \"status\": \"ACTIVE\"\n}"
            },
            "description": "Sales and admin can create customers. Validation failures return 400."
          }
        },
        {
          "name": "List Customers",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/customers?search=Acme&status=ACTIVE",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "customers"
              ],
              "query": [
                {
                  "key": "search",
                  "value": "Acme"
                },
                {
                  "key": "status",
                  "value": "ACTIVE"
                }
              ]
            },
            "description": "Supports search and filters by status and customer type."
          }
        }
      ]
    },
    {
      "name": "Products",
      "item": [
        {
          "name": "Create Product",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/products",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "products"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Premium Rice 25kg\",\n  \"sku\": \"RICE-25KG-001\",\n  \"category\": \"Rice\",\n  \"unitPrice\": 1450,\n  \"currentStock\": 100,\n  \"minimumStock\": 20,\n  \"warehouseLocation\": \"Warehouse A\"\n}"
            },
            "description": "Admin-only endpoint. Duplicate SKU should return 409."
          }
        },
        {
          "name": "List Products",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/products?search=Rice&lowStock=true",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "products"
              ],
              "query": [
                {
                  "key": "search",
                  "value": "Rice"
                },
                {
                  "key": "lowStock",
                  "value": "true"
                }
              ]
            },
            "description": "Authenticated roles can view products. Includes low-stock filtering."
          }
        }
      ]
    },
    {
      "name": "Stock",
      "item": [
        {
          "name": "Create Movement",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/stock/movements",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "stock",
                "movements"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productId\": \"{{productId}}\",\n  \"quantity\": 5,\n  \"movementType\": \"IN\",\n  \"reason\": \"Initial stock\"\n}"
            },
            "description": "Warehouse and admin can create movements. OUT requests exceeding stock return 409 and leave stock unchanged."
          }
        },
        {
          "name": "List Movements",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/stock/movements",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "stock",
                "movements"
              ]
            },
            "description": "View stock movement audit trail."
          }
        }
      ]
    },
    {
      "name": "Challans",
      "item": [
        {
          "name": "Create Challan",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/challans",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "challans"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": \"{{customerId}}\",\n  \"items\": [\n    {\n      \"productId\": \"{{productId}}\",\n      \"quantity\": 2\n    }\n  ]\n}"
            },
            "description": "Creates a draft challan with product snapshots. Draft challans do not reduce stock."
          }
        },
        {
          "name": "Confirm Challan",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/challans/{{challanId}}/confirm",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "challans",
                "{{challanId}}",
                "confirm"
              ]
            },
            "description": "Confirms a draft challan, reduces stock, and creates OUT movements. Failed confirmations return 409 and leave stock unchanged."
          }
        },
        {
          "name": "Cancel Challan",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/challans/{{challanId}}/cancel",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "challans",
                "{{challanId}}",
                "cancel"
              ]
            },
            "description": "Only draft challans can be cancelled. Confirmed challans must remain historical."
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "productId",
      "value": ""
    },
    {
      "key": "customerId",
      "value": ""
    },
    {
      "key": "challanId",
      "value": ""
    }
  ]
}